# PostgreSQL connection string (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tautree?schema=public"

# --- Auth.js (NextAuth v5) ---
# Required. Generate with: npx auth secret  (or openssl rand -base64 32)
AUTH_SECRET=""

# Public base URL of the app (needed on Vercel/production; optional in local dev).
# AUTH_URL="https://tautree.com"

# Canonical app URL — used for metadata, OG image links, and "domain/username"
# display. Public (sent to the browser). No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <base-url>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Magic-link email (Nodemailer). SMTP connection string + sender address.
# Examples:
#   smtp://user:pass@smtp.gmail.com:587
#   smtp://user:pass@sandbox.smtp.mailtrap.io:2525
EMAIL_SERVER=""
EMAIL_FROM="Tautree <no-reply@tautree.com>"

# --- Docker Compose only ---
# Credentials for the bundled `db` (postgres) service.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="tautree"
# When running via docker compose, point DATABASE_URL at the `db` service host
# (not localhost), e.g.:
#   DATABASE_URL="postgresql://postgres:postgres@db:5432/tautree?schema=public"
# Host port the app is published on (container always listens on 3000).
PORT="3000"
