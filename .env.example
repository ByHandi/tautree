# PostgreSQL connection string (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tautree?schema=public"

# --- Auth.js (NextAuth v5) ---
# Required. Generate with: npx auth secret  (or openssl rand -base64 32)
AUTH_SECRET=""

# Public base URL of the app (needed on Vercel/production; optional in local dev).
# AUTH_URL="https://tautree.com"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <base-url>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Magic-link email (Nodemailer). SMTP connection string + sender address.
# Examples:
#   smtp://user:pass@smtp.gmail.com:587
#   smtp://user:pass@sandbox.smtp.mailtrap.io:2525
EMAIL_SERVER=""
EMAIL_FROM="Tautree <no-reply@tautree.com>"
