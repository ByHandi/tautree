// Tautree schema — learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

// LINK   = a normal clickable button.
// HEADER = a non-clickable section label used to group links (no URL).
// EMBED  = a YouTube/Spotify URL rendered inline as an iframe.
enum LinkType {
  LINK
  HEADER
  EMBED
}

model User {
  id            String    @id @default(uuid(7))
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  username      String?   @unique
  name          String?
  bio           String?
  image         String?
  avatarUrl     String?   @map("avatar_url")
  theme         String    @default("default")
  customTheme   Json?     @map("custom_theme")
  role          Role      @default(USER)
  suspended     Boolean   @default(false)
  links         Link[]
  views         ProfileView[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

// --- Auth.js (NextAuth v5) models ---
// Field names like refresh_token / providerAccountId are required verbatim by
// the Auth.js Prisma adapter; only DB column/table names are mapped to snake_case.

model Account {
  id                String  @id @default(uuid(7))
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid(7))
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Link {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      LinkType @default(LINK)
  title     String
  // Null for HEADER rows (section labels have no destination).
  url       String?
  // Optional custom icon for a LINK, stored as a small image data URI
  // (resized client-side, size-capped server-side). Null = use the auto
  // social icon. See `parseThumbnail`.
  thumbnail String?
  order     Int       @default(0)
  isActive  Boolean   @default(true) @map("is_active")
  clicks    Int       @default(0)
  // Optional scheduling window. Null = no bound: a null `startsAt` means live
  // immediately, a null `endsAt` means live forever. See `isLinkLive`.
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  clickEvents Click[]

  @@index([userId])
  @@map("links")
}

// Privacy-friendly profile page view log. Captures only a coarse device class
// and the registrable referrer host (or null = direct) — no IP, no full
// user-agent, no cookies. Powers the traffic-source and device breakdowns.
model ProfileView {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    String
  referrer  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("profile_views")
}

// Per-click event log for time-series analytics. The denormalized `Link.clicks`
// counter stays the source of truth for quick per-link totals; these rows power
// the over-time chart.
model Click {
  id        String   @id @default(uuid(7))
  linkId    String   @map("link_id")
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([linkId])
  @@index([createdAt])
  @@map("click_events")
}
